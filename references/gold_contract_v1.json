    "LABEL_AVAILABLE_AT": "datetime64[ns]",
    "TX_FRAUD": "int8"
  },
  "feature_columns": {
    "TX_AMOUNT": "float64",
    "TX_HOUR": "int8",
    "TX_WEEKDAY": "int8",
    "CUSTOMER_TX_COUNT_1D": "int64",
    "CUSTOMER_AVG_AMOUNT_1D": "float64",
    "CUSTOMER_AMOUNT_RATIO_1D": "float64",
    "CUSTOMER_AMOUNT_RATIO_VALID_1D": "int8",
    "CUSTOMER_TX_COUNT_7D": "int64",
    "CUSTOMER_AVG_AMOUNT_7D": "float64",
    "CUSTOMER_AMOUNT_RATIO_7D": "float64",
    "CUSTOMER_AMOUNT_RATIO_VALID_7D": "int8",
    "TERMINAL_TX_COUNT_1D": "int64",
    "TERMINAL_KNOWN_LABEL_COUNT_1D": "int64",
    "TERMINAL_KNOWN_FRAUD_COUNT_1D": "int64",
    "TERMINAL_KNOWN_FRAUD_RATE_1D": "float64",
    "TERMINAL_TX_COUNT_7D": "int64",
    "TERMINAL_KNOWN_LABEL_COUNT_7D": "int64",
    "TERMINAL_KNOWN_FRAUD_COUNT_7D": "int64",
    "TERMINAL_KNOWN_FRAUD_RATE_7D": "float64"
  },
  "excluded_column": "TX_FRAUD_SCENARIO",
  "fitted_transformations": []
}
