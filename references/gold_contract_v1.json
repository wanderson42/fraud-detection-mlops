{
  "schema_version": 1,
  "version": "gold_v1",
  "source_layer": "silver_v1",
  "protocol_version": "temporal_v1",
  "window_days": [
    1,
    7
  ],
  "label_delay_days": 7,
  "event_history": "[t-window,t)",
  "known_label_history": "[t-delay-window,t-delay)",
