        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "description": "Contagem de suporte por janela; cor fixa neutra, sem interpretar maior contagem como falha. Comparação válida é indicada no painel próprio.",
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_feature_rows",
          "instant": true,
          "legendFormat": "{{feature}}{{window}}"
