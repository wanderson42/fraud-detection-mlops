{
  "schemaVersion": 41,
  "editable": false,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "uid": "fraud-feature-health",
  "title": "Fraud — dados e features persistidas",
  "version": 2,
  "tags": [
    "fraud",
    "local",
    "features-v1"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Escopo e leitura",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Requisições já persistidas: primeiras 1.000 decisões versus últimas 1.000, sem sobreposição. Baseline operacional, não de treino. Sem suporte ou com dados inválidos, divergência ausente. Relógio de features comparado ao evento, nunca agora − 2018. Sem CT, nova avaliação ou SLA."
      }
    },
    {
      "id": 2,
      "title": "Coletor válido",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "description": "Snapshot de janelas do protocolo. Ausência de série não é zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_monitor_collector_up",
          "instant": true,
          "legendFormat": "{{feature}}{{window}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem suporte ou coletor indisponível"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Comparação com suporte e dados válidos",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "datasource": {
