{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ownerId",
    "images",
    "activeSlot",
    "greenEnabled",
    "greenReplicas",
    "manifests",
    "blueReplicas",
    "slotImages"
  ],
  "properties": {
    "ownerId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "artifacts",
        "gateway"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^fraud-kind-serving-runtime:[a-f0-9]{32}$"
        },
        "artifacts": {
          "type": "string",
          "pattern": "^fraud-kind-serving-artifacts:[a-f0-9]{32}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^fraud-kind-serving-gateway:[a-f0-9]{32}$"
        }
      }
    },
    "activeSlot": {
      "enum": [
        "blue",
        "green"
      ]
    },
    "greenEnabled": {
      "type": "boolean"
    },
    "greenReplicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blue",
        "green"
      ],
      "properties": {
        "blue": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "green": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "blueReplicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "slotImages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blue",
        "green"
      ],
      "properties": {
        "blue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "artifacts"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "pattern": "^fraud-kind-serving-runtime:[a-f0-9]{32}$"
            },
            "artifacts": {
              "type": "string",
              "pattern": "^fraud-kind-serving-artifacts:[a-f0-9]{32}$"
            }
          }
        },
        "green": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "artifacts"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "pattern": "^fraud-kind-serving-runtime:[a-f0-9]{32}$"
            },
            "artifacts": {
              "type": "string",
              "pattern": "^fraud-kind-serving-artifacts:[a-f0-9]{32}$"
            }
          }
        }
      }
    }
  }
}
