{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "image"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "image": {
      "type": "string",
      "pattern": "^fraud-kind-replay:[a-f0-9]{32}$"
    }
  }
}
