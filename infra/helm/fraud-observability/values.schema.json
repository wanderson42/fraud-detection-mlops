{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ownerId",
    "stateReady",
    "images"
  ],
  "properties": {
    "ownerId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "stateReady": {
      "type": "boolean"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exporter",
        "prometheus",
        "grafana"
      ],
      "properties": {
        "exporter": {
          "type": "string",
          "pattern": "^fraud-kind-observability-exporter:[a-f0-9]{32}$"
        },
        "prometheus": {
          "type": "string",
          "pattern": "^fraud-kind-observability-prometheus:[a-f0-9]{32}$"
        },
        "grafana": {
          "type": "string",
          "pattern": "^fraud-kind-observability-grafana:[a-f0-9]{32}$"
        }
      }
    },
    "sessionTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^fraud-session-monitor:[a-f0-9]{32}$"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "session_sha256",
            "model_sha256",
            "serving_release_id",
            "expected_events",
            "expected_decisions"
          ],
          "properties": {
            "session_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "serving_release_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "session_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "expected_events": {
              "type": "integer",
              "minimum": 1
            },
            "expected_decisions": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "image",
              "binding"
            ]
          }
        }
      ]
    },
    "legacyReplay": {
      "type": "boolean",
      "default": true
    },
    "sessionComponents": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "legacyReplay"
        ],
        "properties": {
          "legacyReplay": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "sessionTelemetry"
        ],
        "properties": {
          "sessionTelemetry": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "sessionComponents"
        ],
        "properties": {
          "sessionComponents": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "legacyReplay",
          "sessionTelemetry"
        ],
        "properties": {
          "legacyReplay": {
            "const": false
          },
          "sessionTelemetry": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
