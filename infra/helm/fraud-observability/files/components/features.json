      "datasource": {
        "type": "prometheus",
        "uid": "fraud-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace({__name__=~\"fraud_session_detail_feature_invalid_(TX_AMOUNT|TX_HOUR|TX_WEEKDAY|CUSTOMER_TX_COUNT_1D|CUSTOMER_AVG_AMOUNT_1D|CUSTOMER_AMOUNT_RATIO_1D|CUSTOMER_AMOUNT_RATIO_VALID_1D|CUSTOMER_TX_COUNT_7D|CUSTOMER_AVG_AMOUNT_7D|CUSTOMER_AMOUNT_RATIO_7D|CUSTOMER_AMOUNT_RATIO_VALID_7D|TERMINAL_TX_COUNT_1D|TERMINAL_KNOWN_LABEL_COUNT_1D|TERMINAL_KNOWN_FRAUD_COUNT_1D|TERMINAL_KNOWN_FRAUD_RATE_1D|TERMINAL_TX_COUNT_7D|TERMINAL_KNOWN_LABEL_COUNT_7D|TERMINAL_KNOWN_FRAUD_COUNT_7D|TERMINAL_KNOWN_FRAUD_RATE_7D)\"} and on(session_id,session_sha256) (fraud_session_source_valid == 1) and on(session_id,session_sha256) (fraud_session_details_available == 1) and on(session_id,session_sha256) (fraud_session_detail_feature_current_rows > 0), \"feature\", \"$1\", \"__name__\", \"fraud_session_detail_feature_invalid_(.+)\")",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Indisponível",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Feature"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 530
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "feature",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "feature": 0,
              "Value": 1
            },
            "renameByName": {
              "feature": "Feature",
              "Value": "Valor"
            },
            "excludeByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Feature",
                "desc": false
              }
            ]
          }
        }
      ],
      "description": "Uma linha por feature; Valor usa a unidade indicada na tabela. Ausência da fonte não é convertida em zero."
    },
